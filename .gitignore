# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==========================================
# Visual Studio / VS Code (IDE & Build Artifacts)
# ==========================================
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.suo
*.user
*.sln.docstates

# ==========================================
# C++ Build Artifacts & Executables
# ==========================================
# Compiled object files
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Libraries and Archives
*.a
*.lib
*.so
*.dylib
*.dll

# Executables
*.exe
*.out
*.app

# ==========================================
# Build Tools (CMake, Make, Ninja)
# ==========================================
# CMake output directory
build/
Build/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# ==========================================
# Logs and Temporary files
# ==========================================
*.log
*.tmp
*.bak
*.swp
